# Performance Problem Simulator - Environment Configuration
# Copy this file to .env and modify as needed

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Server configuration (used by uvicorn)
HOST=0.0.0.0
PORT=8000

# WebSocket configuration
WS_HEARTBEAT_INTERVAL=500

# Health probe interval in milliseconds (min 100, default 200)
# Increase to reduce probe overhead during profiling
HEALTH_PROBE_RATE=200
